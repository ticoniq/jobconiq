generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum UserRole {
  ADMIN
  DEVELOPER
  COMPANY
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           UserRole         @default(DEVELOPER)
  accounts       Account[]
  developers     Developer[]
  companies      Company[]
  jobs           Job[]
  jobApplication JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Developer {
  id            String    @id @default(cuid())
  userId        String    @unique
  phone         String?
  title         String?
  gender        String?
  dob           DateTime?
  bio           String?
  experience    String?
  qualification String?
  location      String?
  skills        String[]
  languages     String[]
  resumeUrl     String?
  website       String?
  github        String?
  linkedin      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("developers")
}

model Company {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  @@unique([email, token])
  @@map("verificationtokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  @@unique([email, token])
  @@map("passwordresettokens")
}

model Job {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  type            String
  locationType    String
  location        String?
  description     String?
  salary          Int
  categories      String[]
  skills          String[]
  userId          String
  jobapplications JobApplication[]
  approved        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model JobApplication {
  id               String   @id @default(cuid())
  slug             String   @unique
  jobId            String
  userId           String
  fullName         String
  emailAddress     String
  phoneNumber      String
  currentJobTitle  String
  linkedInURL      String?
  portfolioURL     String?
  additionalInfo   String?
  resumeAttachment String?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jobapplications")
}
